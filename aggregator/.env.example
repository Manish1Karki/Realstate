LAND_DB=data/properties.sqlite3
# Free hosted persistence. Leave empty to use local SQLite during development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LAND_REQUIRE_PERSISTENT_DB=false
# Run a background multi-source collection cycle on every backend startup.
LAND_AUTO_SCRAPE=true
LAND_AUTO_SCRAPE_PAGES=6
LAND_AUTO_SCRAPE_LIMIT=80
# Opt-in experiments only work with a local database, never with hosted settings.
LAND_LOCAL_SOURCE_TRIAL=false
# Authentication: list exact frontend origins; enable secure cookies with HTTPS.
LAND_AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
LAND_AUTH_SECURE_COOKIE=false
# Hosted prototype API proxy. Keep false for direct local development.
LAND_REQUIRE_PROXY=false
# Temporary unauthenticated password reset by account email, restricted to local SQLite loopback development.
# Keep false in shared or hosted environments; use verified reset emails there.
LAND_LOCAL_PASSWORD_RESET=false
LAND_PROXY_SECRET=
LAND_IMPORT_TOKEN=
LAND_PUBLIC_URL=http://127.0.0.1:3000
# Optional password reset and email-change delivery. Configure these for hosted email verification.
LAND_SMTP_HOST=
LAND_SMTP_PORT=587
LAND_SMTP_USER=
LAND_SMTP_PASSWORD=
LAND_MAIL_FROM=
LAND_USER_AGENT=LandDiscoverResearch/0.1
# Identify your deployment before running geocoding. Email or project URL.
LAND_CONTACT=
# Approximate address geocoding is research-only and never qualifies a listing for display.
# Enable only for low-volume local research or with a provider that permits automation.
LAND_AUTO_GEOCODE=false
# Calculate school, hospital and mapped-road distances only for source-published map pins.
LAND_AUTO_ENRICH=false
LAND_AUTO_ENRICH_RADIUS=1500
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Refresh the external listing cache every six hours.
LAND_AUTO_SCRAPE_INTERVAL_HOURS=6
