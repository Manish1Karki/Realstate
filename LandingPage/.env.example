# Public property marketplace route.
VITE_DASHBOARD_URL=/properties
# Leave blank locally: Vite proxies /api to the FastAPI server on port 8000.
# In production, serve /api from the same origin or set an API origin with CORS.
VITE_PROPERTY_API_URL=

# Leave blank for the built-in /api/auth service through Vite's /api proxy.
# Serve frontend and API on the same origin in production.
VITE_AUTH_API_URL=
# Optional external Google OAuth service. Hidden when not configured.
VITE_GOOGLE_AUTH_URL=
