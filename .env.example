# Vercel server-side API proxy settings; never use VITE_ prefixes for secrets.
BACKEND_API_URL=https://your-backend.onrender.com
# Copy the backend's LAND_PROXY_SECRET value from Render into Vercel.
BACKEND_PROXY_SECRET=
# Set the canonical site origin in production; this is safe to expose publicly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
