{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:apps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/proxy.js": { "maxDuration": 120 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/aggregator", "destination": "/aggregator/index.html" },
    { "source": "/aggregator/:path*", "destination": "/aggregator/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/properties", "destination": "/index.html" },
    { "source": "/properties/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
