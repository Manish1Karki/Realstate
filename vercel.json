{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm run install:apps",
  "buildCommand": "npm run build",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!property-chat(?:/|$)).*)",
      "destination": "/api/proxy?path=:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/visual-tour/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
